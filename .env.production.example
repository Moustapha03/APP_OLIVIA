# =============================================================================
# PRODUCTION settings (server). Copy to .env on the server and fill the blanks.
# Never commit the filled file. No secret belongs in this example.
# After editing: php artisan config:clear (then config:cache on the server only).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Transport Tickets"
APP_ENV=production
# Generate on the server: php artisan key:generate
APP_KEY=
# Never true in production (would show code, queries and secrets on errors).
APP_DEBUG=false
# Public https address. Password reset / e-mail verification links and
# receipt links are built from it; any other Host header is refused.
APP_URL=https://billetterie.example.ci
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Reverse proxies allowed to send X-Forwarded-* headers (IPs or CIDR,
# comma separated), e.g. the load balancer: 10.0.0.5,10.0.1.0/24
# Empty = none (Nginx + PHP-FPM on the same machine). Never "*".
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions (https only, encrypted, stored in the database)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache, queues
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=transport_

# -----------------------------------------------------------------------------
# Mail (daily report, password reset)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
DAILY_REPORT_RECIPIENTS=

# -----------------------------------------------------------------------------
# Authentication & security
# Account locked LOCKOUT_MINUTES after MAX_LOGIN_ATTEMPTS failures.
# Unlock from the server: php artisan users:unlock <phone or e-mail>
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# QR code signature (HMAC-SHA256)
# Generate a key:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# -----------------------------------------------------------------------------
QR_SIGNING_KEY_ID=k1
QR_SIGNING_KEY=
QR_SIGNING_PREVIOUS_KEYS=

# -----------------------------------------------------------------------------
# Mobile Money payment
# -----------------------------------------------------------------------------
PAYMENT_DRIVER=cinetpay
# Fill with the notification IPs published by CinetPay (comma separated).
# Empty = no IP filtering: do not leave it empty in production.
PAYMENT_WEBHOOK_ALLOWED_IPS=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-Signature

CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_CHECKOUT_ORIGIN=https://checkout.cinetpay.com

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
SMS_DRIVER=provider
SMS_SENDER_NAME=TRANSPORT
SMS_API_URL=
SMS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
