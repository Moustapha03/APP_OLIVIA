BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8 in production)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_appolivia
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions
# Staff sessions expire after 2 h (STAFF_SESSION_LIFETIME below).
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Forced to true when APP_ENV=production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache, queues, broadcasting
# Production: CACHE_STORE=redis, QUEUE_CONNECTION=redis, SESSION_DRIVER=redis
# Local without Redis: database drivers work out of the box.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=transport_

MEMCACHED_HOST=127.0.0.1

# "predis" works without the phpredis PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (daily report)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated list of recipients.
DAILY_REPORT_RECIPIENTS=

# -----------------------------------------------------------------------------
# Business rules (defaults, see config/transport.php)
# -----------------------------------------------------------------------------
TRANSPORT_CURRENCY=XOF
TRANSPORT_DAILY_RIDES=2
TRANSPORT_SUBSCRIPTION_DAYS=30
TRANSPORT_SUBSCRIPTION_REMINDER_DAYS=3
TRANSPORT_PHOTO_MAX_KB=2048
TRANSPORT_ANTI_REPLAY_MINUTES=30
# Ticket office: thermal printer paper width (58 or 80 mm), max opening float.
TRANSPORT_RECEIPT_WIDTH=80
TRANSPORT_MAX_OPENING_FLOAT=500000

