# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT settings. For a server, start from .env.production.example.
APP_NAME="Transport Tickets"
APP_ENV=local
APP_KEY=
# Must be false in production.
APP_DEBUG=true
# Production: the public https address (receipt links sent by WhatsApp use it)
APP_URL=http://localhost:8000
# Reverse proxies allowed to send X-Forwarded-* headers (IPs or CIDR,
# comma separated). Empty = none: keep it empty unless a load balancer or
# another Nginx sits in front of the application. Never "*".
TRUSTED_PROXIES=
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (MySQL 8 in production)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_appolivia
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions
# Staff sessions expire after 2 h (STAFF_SESSION_LIFETIME below).
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE is left unset on purpose: it is true automatically
# when APP_ENV=production and false otherwise (local http://localhost).
# Never copy "SESSION_SECURE_COOKIE=false" to a server: the session cookie
# would also travel over plain http. See .env.production.example.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache, queues, broadcasting
# Production: CACHE_STORE=redis, QUEUE_CONNECTION=redis, SESSION_DRIVER=redis
# Local without Redis: database drivers work out of the box.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=transport_

MEMCACHED_HOST=127.0.0.1

# "predis" works without the phpredis PHP extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (daily report)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma separated list of recipients.
DAILY_REPORT_RECIPIENTS=

# -----------------------------------------------------------------------------
# Business rules (defaults, see config/transport.php)
# -----------------------------------------------------------------------------
TRANSPORT_CURRENCY=XOF
TRANSPORT_DAILY_RIDES=2
TRANSPORT_SUBSCRIPTION_DAYS=30
TRANSPORT_SUBSCRIPTION_REMINDER_DAYS=3
TRANSPORT_PHOTO_MAX_KB=2048
TRANSPORT_ANTI_REPLAY_MINUTES=30
# On-board control: scans from this time (HH:MM) count as the evening trip.
TRANSPORT_EVENING_STARTS_AT=12:00
# Ticket office: thermal printer paper width (58 or 80 mm), max opening float.
TRANSPORT_RECEIPT_WIDTH=80
TRANSPORT_MAX_OPENING_FLOAT=500000

# -----------------------------------------------------------------------------
# QR code signature (HMAC-SHA256)
# Generate a key:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Rotation: move the current "id:key" into QR_SIGNING_PREVIOUS_KEYS,
# then set a new id and key.
# -----------------------------------------------------------------------------
QR_SIGNING_KEY_ID=k1
QR_SIGNING_KEY=
QR_SIGNING_PREVIOUS_KEYS=

# -----------------------------------------------------------------------------
# Authentication & security
# Login: phone number + password for everyone (no SMS code, no 2FA).
# Account locked LOCKOUT_MINUTES after MAX_LOGIN_ATTEMPTS failures.
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Mobile Money payment (fake | cinetpay)
# -----------------------------------------------------------------------------
PAYMENT_DRIVER=fake
# Comma separated IPs of the aggregator (empty = no IP filtering).
PAYMENT_WEBHOOK_ALLOWED_IPS=
# HMAC-SHA256 secret of the webhook signature (header PAYMENT_WEBHOOK_SIGNATURE_HEADER).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-Signature

CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_CHECKOUT_ORIGIN=https://checkout.cinetpay.com

# -----------------------------------------------------------------------------
# SMS (log | provider)
# -----------------------------------------------------------------------------
SMS_DRIVER=log
SMS_SENDER_NAME=TRANSPORT
SMS_API_URL=
SMS_API_KEY=

# -----------------------------------------------------------------------------
# Optional cloud storage (subscriber photos stay on a private disk)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
